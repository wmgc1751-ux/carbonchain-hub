# =====================================================================
#  碳链通 CarbonChain Hub —— 环境变量示例
#  用法：复制为 .env 使用；云端部署时把下列键值填进平台的 Environment 面板
#  注意：本文件只含占位符，切勿把真实的密码/密钥提交进仓库
# =====================================================================

# ---- HTTP 服务（云平台通常自动注入 PORT，无需手工设置） ----
PORT=8300
HOST=0.0.0.0

# ---- 数据库 ----
# 本地跑：132 局域网/本机 MySQL 用下面这组
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=carbon_chain

# 云端跑：把上面四个改成云数据库控制台给出的连接信息，并按需开启下面两项
# DB_SSL=true          # 启用 TLS（校验证书），TiDB Cloud 等托管库必需
# DB_SSL=no-verify     # 启用 TLS 但不校验证书（免费实例常不提供 CA，推荐先用这个）
# DB_MANAGED=true      # 库由平台预先创建、当前账号无 CREATE/DROP DATABASE 权限时开启

# ---- 会话密钥（线上务必改成随机长串，否则任何人都能伪签 token） ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- 区块链参数 ----
CHAIN_DIFFICULTY=4
CHAIN_AUTOMINE=true
CHAIN_NODE=node-carbon-01

# ---- 联盟链共识（默认 POA 授权证明；POW 仅用于兼容历史链） ----
CHAIN_CONSENSUS=POA

# ---- 动态核算引擎 ----
# CEMS 采数 + 滚动核算的间隔（毫秒，默认 60000 = 每分钟滚动一次）
CEMS_INTERVAL_MS=60000

# =====================================================================
#  生产环境安全项（NODE_ENV=production 时缺失将拒绝启动）
# =====================================================================
NODE_ENV=development

# 链上私钥库加密口令：设置后 server/keystore.json 以 AES-256-GCM 加密落盘
KEYSTORE_SECRET=

# 允许的跨域来源（逗号分隔）。留空 = 开发宽松模式；生产建议显式配置
CORS_ORIGINS=

# 演示账号接口开关：生产环境默认关闭；仅演示/答辩时置 true
DEMO_ACCOUNTS=false

# ============ AI 顾问 · 市面大模型接入 ============
# 协议：OpenAI chat/completions 兼容（下列各家均支持）
# 判定顺序：LLM_PROVIDER（显式指定） → LLM_API_KEY+LLM_BASE_URL（自定义端点）
#           → 各家专有变量 → 本地 Ollama（需实测可达）
# 配了多家即自动组故障转移链（按下面顺序优先），一家挂掉换下一家。
# 自检：npm run llm:doctor        离线自测：npm run verify:llm
#
# ① 智谱 GLM（推荐起步：glm-4-flash 有免费额度）
# ZHIPU_API_KEY=xxxxxxxx.xxxxxxxxxxxxxxxx
# GLM_MODEL 默认 glm-4-flash，可用 LLM_MODEL 覆盖
#
# ② DeepSeek（质量稳、价格低）
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ③ 阿里云百炼 · 通义千问（兼容模式端点）
# DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ④ Moonshot · Kimi (长文本)
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ⑤ 硅基流动 SiliconFlow（一个 key 切多家开源模型）
# SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ⑥ 火山方舟 · 豆包
# ARK_API_KEY=xxxxxxxx-xxxx-xxxx
#
# ⑦ 百度千帆 · 文心
# QIANFAN_API_KEY=bce-v3/ALTAK-xxxxxxxx
#
# ⑧ 腾讯混元
# HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ⑨ OpenAI（国内通常需代理）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
#
# ⑩ 本地 Ollama（完全离线；需 ollama pull qwen2.5:7b）
# LLM_PROVIDER=ollama
#
# —— 通用开关 ——
# LLM_PROVIDER=deepseek     强制只用某一家（不静默换家，便于确认在用的是哪家）
# LLM_MODEL=deepseek-chat   覆盖默认模型名
# LLM_TIMEOUT_MS=30000      单次调用超时
# LLM_MAX_TOKENS=2048
# 走代理/私有化部署时按家覆盖接入点，例：
# DEEPSEEK_BASE_URL=http://127.0.0.1:8000/v1
#
# 未配置任何一家时：AI 顾问自动使用内置规则引擎（仅平台内数据，数字全部来自
# 数据库），服务不中断 —— 平台内问题照样能答，只是没有平台外知识与润色。
