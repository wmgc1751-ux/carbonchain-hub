# =====================================================================
#  云端数据库连接信息（TiDB Cloud 等免费 MySQL 兼容服务）
#  用途：执行 node server/scripts/check-cloud-db.js 时会读取本文件
#  注意：本文件含密码，已在 .gitignore 中排除，不会被提交到仓库
# =====================================================================

# ---- 把下面每一项换成你云数据库控制台里的真实值 ----

# 主机地址（TiDB Cloud 集群详情页 Connect 面板里的 Endpoint / Host）
DB_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com

# 端口（TiDB Cloud 是 4000；普通云 MySQL 才是 3306）
DB_PORT=4000

# 用户名（⚠️ TiDB Cloud 的用户名形如 3pTAoNNegb47Uc8.root，必须带前缀，不能只填 root）
DB_USER=xxxxxxxxxxxx.root

# 密码（创建集群时你自己设置的 root 密码）
DB_PASSWORD=在此填入你的密码

# 库名（TiDB Cloud 默认提供 test 库）
DB_NAME=test
